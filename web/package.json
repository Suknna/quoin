{
  "name": "@quoin/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:real": "VITE_QUOIN_MODE=real vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.mock.config.ts",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "test:e2e:real-local": "playwright test --config playwright.real-local.config.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.14",
    "@assistant-ui/react-data-stream": "0.12.26",
    "@novnc/novnc": "1.7.0",
    "@shadcn/react": "^0.3.1",
    "@vitejs/plugin-react": "6.0.5",
    "assistant-stream": "0.3.37",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.2.6",
    "diff": "9.0.0",
    "lucide-react": "1.42.0",
    "playwright-core": "1.62.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vite": "8.2.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "jsdom": "29.0.0",
    "msw": "2.12.10",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vitest": "4.1.1"
  }

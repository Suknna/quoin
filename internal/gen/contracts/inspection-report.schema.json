{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Suknna/quoin/schemas/inspection-report.schema.json",
  "title": "Quoin immutable Inspection Report contracts",
  "description": "Manual Inspection 的 Plinth report-analysis input 与 ResultProposal。所有 locator 均由 Quoin 在冻结 Input 和单一 SQLite closure 中重新裁决。计划 Run（ADR-0004）的 input 另携带 Run 冻结的计划绑定、逐检查项结构化清单与（仅显式重分析时的）报告要求三态：字段缺省继承 Run 冻结初始要求，空串为本次显式无要求，非空为仅本次覆盖；历史声明 Run 不携带这些字段。",
  "oneOf": [{"$ref":"#/$defs/input"},{"$ref":"#/$defs/result"}],
  "$defs": {
    "id": {"type":"integer","minimum":1},
    "digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "modelContract": {"type":"object","additionalProperties":false,"required":["modelId","contextBudgetTokens","maxOutputTokens"],"properties":{"modelId":{"type":"string","minLength":1,"maxLength":500},"contextBudgetTokens":{"type":"integer","minimum":1},"maxOutputTokens":{"type":"integer","minimum":1}}},
    "planContext": {"type":"object","additionalProperties":false,"required":["key","params","scope"],"properties":{"key":{"type":"string","minLength":1,"maxLength":200},"params":{"type":"object"},"scope":{"type":"object"},"checkDescription":{"type":"string","minLength":1,"maxLength":2000},"metricUnit":{"type":"string","minLength":1,"maxLength":100},"reportInstructions":{"type":"string","minLength":1,"maxLength":4000}}},
    "checkItem": {"type":"object","additionalProperties":false,"required":["checkKey","displayName","status"],"properties":{"checkKey":{"type":"string","minLength":1,"maxLength":200},"displayName":{"type":"string","minLength":1,"maxLength":500},"status":{"enum":["ok","gap","error","pending"]},"evidenceId":{"$ref":"#/$defs/id"},"artifactId":{"$ref":"#/$defs/id"},"expression":{"type":"string","minLength":1,"maxLength":100000},"rangeSeconds":{"type":"integer","minimum":1},"stepSeconds":{"type":"integer","minimum":1},"observedAt":{"type":"string","minLength":1,"maxLength":100},"windowStartAt":{"type":"string","minLength":1,"maxLength":100},"windowEndAt":{"type":"string","minLength":1,"maxLength":100},"executedStepSeconds":{"type":"integer","minimum":1},"warnings":{"type":"array","items":{"type":"string"}},"gapReason":{"type":"string","minLength":1,"maxLength":100}}},
    "input": {"type":"object","additionalProperties":false,"required":["schemaKind","attemptId","inspectionRunId","reportVersion","configVersionId","planKey","evidenceIds","artifactIds","knowledgeVersionIds","modelContract"],"properties":{"schemaKind":{"const":"inspection_analysis_v1"},"attemptId":{"$ref":"#/$defs/id"},"inspectionRunId":{"$ref":"#/$defs/id"},"reportVersion":{"$ref":"#/$defs/id"},"configVersionId":{"type":"integer","minimum":0},"planKey":{"type":"string","minLength":1,"maxLength":200},"evidenceIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"artifactIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"knowledgeVersionIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"modelContract":{"$ref":"#/$defs/modelContract"},"plan":{"$ref":"#/$defs/planContext"},"connectionName":{"type":"string","minLength":1,"maxLength":200},"templateId":{"type":"string","minLength":1,"maxLength":200},"templateVersion":{"type":"string","minLength":1,"maxLength":100},"checks":{"type":"array","items":{"$ref":"#/$defs/checkItem"}},"reportInstructionsOverride":{"type":"string","maxLength":4000}}},
    "result": {"type":"object","additionalProperties":false,"required":["schemaKind","attemptId","inspectionRunId","modelCallId","outcome","content","evidenceIds","artifactIds","knowledgeVersionIds","resultDigest","evidenceDigest","promptDigest"],"properties":{"schemaKind":{"const":"inspection_report_result_v1"},"attemptId":{"$ref":"#/$defs/id"},"inspectionRunId":{"$ref":"#/$defs/id"},"modelCallId":{"$ref":"#/$defs/id"},"outcome":{"const":"success"},"content":{"type":"string","minLength":1,"maxLength":1000000},"evidenceIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"artifactIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"knowledgeVersionIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"resultDigest":{"$ref":"#/$defs/digest"},"evidenceDigest":{"$ref":"#/$defs/digest"},"promptDigest":{"$ref":"#/$defs/digest"}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Suknna/quoin/schemas/deployment-config.schema.json",
  "x-quoin-contract-version": 1,
  "title": "Quoin v1 deployment inputs and component configuration",
  "description": "OPS-CONFIG-001..004 的唯一机器权威。根 oneOf 校验四组件进程配置及 Compose 验证辅助输入；Kubernetes 直接使用普通 YAML；不包含 Admin Web UI 设置、镜像版本、replica/HPA、内部监听地址或内部端口。",
  "oneOf": [
    {
      "$ref": "#/$defs/composeInstallInput"
    },
    {
      "$ref": "#/$defs/quoinConfig"
    },
    {
      "$ref": "#/$defs/plinthConfig"
    },
    {
      "$ref": "#/$defs/steleConfig"
    }
  ],
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "publicOrigin": {
      "type": "string",
      "description": "规范公共 Origin；仅 scheme + authority，无 path/query/fragment。",
      "pattern": "^https://(?:\\[[0-9A-Fa-f:]+\\]|[^/?#:\\s]+)(?::[0-9]{1,5})?$",
      "maxLength": 512
    },
    "stelePublicURL": {
      "type": "string",
      "description": "Alertmanager 到 Stele 的部署公开 receiver URL；必须是 HTTPS 且固定为 /stele/alerts，不从请求 Host 推导。",
      "pattern": "^https://(?:\\[[0-9A-Fa-f:]+\\]|[^/?#:\\s]+)(?::[0-9]{1,5})?/stele/alerts$",
      "maxLength": 512
    },
    "quoinRuntimeEndpoint": {
      "type": "string",
      "description": "Runtime/Stele 拨号的 Quoin TLS gRPC endpoint；这是远端地址，不是本进程监听配置。",
      "pattern": "^https://(?:\\[[0-9A-Fa-f:]+\\]|[^/?#:\\s]+):[0-9]{1,5}$",
      "maxLength": 512
    },
    "hostPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "enabledPlugins": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "composeInstallInput": {
      "$anchor": "composeInstallInput",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "publicOrigin",
        "publishMode",
        "secretDirectory"
      ],
      "properties": {
        "document": {
          "const": "compose-install"
        },
        "publicOrigin": {
          "$ref": "#/$defs/publicOrigin"
        },
        "publishMode": {
          "enum": [
            "loopback",
            "internal-network-only"
          ]
        },
        "quoinPublicHostPort": {
          "$ref": "#/$defs/hostPort"
        },
        "steleWebhookHostPort": {
          "$ref": "#/$defs/hostPort"
        },
        "externalProxyNetwork": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "secretDirectory": {
          "$ref": "#/$defs/absolutePath"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "publishMode": {
                "const": "loopback"
              }
            }
          },
          "then": {
            "required": [
              "quoinPublicHostPort",
              "steleWebhookHostPort"
            ],
            "not": {
              "required": [
                "externalProxyNetwork"
              ]
            }
          },
          "else": {
            "required": [
              "externalProxyNetwork"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "quoinPublicHostPort"
                  ]
                },
                {
                  "required": [
                    "steleWebhookHostPort"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "deploymentBinding": {
      "description": "安装/升级时冻结的不可变部署绑定；Quoin 启动时校验并只读，Deployment Acceptance 以它作为站点 release subject 与部署配置的权威绑定。本地开发投影省略该字段，此时 Deployment Acceptance 不可用。",
      "additionalProperties": false,
      "required": [
        "releaseVersion",
        "releaseSubjectDigest",
        "deploymentConfigDigest",
        "backend",
        "architecture"
      ],
      "properties": {
        "releaseVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "releaseSubjectDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "deploymentConfigDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "backend": {
          "enum": [
            "compose",
            "kubernetes"
          ]
        },
        "architecture": {
          "enum": [
            "linux/amd64",
            "linux/arm64"
          ]
        }
      }
    },
    "quoinConfig": {
      "$anchor": "quoinConfig",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "publicOrigin",
        "dataDirectory",
        "backupDirectory",
        "rootKeyFile",
        "runtimeTlsCertificateFile",
        "runtimeTlsPrivateKeyFile",
        "runtimeClientCaFile"
      ],
      "properties": {
        "component": {
          "const": "quoin"
        },
        "publicOrigin": {
          "$ref": "#/$defs/publicOrigin"
        },
        "dataDirectory": {
          "$ref": "#/$defs/absolutePath"
        },
        "backupDirectory": {
          "$ref": "#/$defs/absolutePath"
        },
        "rootKeyFile": {
          "$ref": "#/$defs/absolutePath"
        },
        "runtimeTlsCertificateFile": {
          "$ref": "#/$defs/absolutePath"
        },
        "runtimeTlsPrivateKeyFile": {
          "$ref": "#/$defs/absolutePath"
        },
        "stelePublicURL": {
          "$ref": "#/$defs/stelePublicURL"
        },
        "deploymentBinding": {
          "$ref": "#/$defs/deploymentBinding"
        },
        "enabledPlugins": {
          "$ref": "#/$defs/enabledPlugins",
          "description": "显式插件启用白名单（ADR-0004）。字段省略=启用全部 DefaultEnabled 插件（prometheus/thanos/alertmanager）；显式空数组=全部停用——省略与空数组是不同的部署事实。未知插件 ID 使组件启动失败。"
        },
        "authentication": {
          "$ref": "#/$defs/quoinAuthentication"
        },
        "audit": {
          "$ref": "#/$defs/quoinAudit"
        },
        "runtimeClientCaFile": {
          "$ref": "#/$defs/absolutePath",
          "description": "签发客户端证书的部署 CA 证书（runtime-ca.pem）；Runtime gRPC 监听以它校验 mTLS 客户端证书。"
        }
      }
    },
    "quoinAuthentication": {
      "description": "部署侧认证投递引导（统一认证设计第 8 节）。configuration 是管理员运行时投递设置的部署预设，仅当本 YAML 提供时才存在部署来源预设；secretsFile 指向只读的秘密引用映射文件（引用名→值，JSON 或 YAML）。整节可省略；省略时部署不预置投递设置，管理员运行时配置的秘密仍经根密钥加密保存，绝不写入本文件。",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "configuration": {
          "$ref": "#/$defs/authDeliveryDeployment"
        },
        "secretsFile": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "authDeliveryDeployment": {
      "description": "认证投递渠道映射，与 auth_delivery_settings.configuration_json 的机器形状一致：email 渠道为 SMTP 投递，sms 渠道必须是 webhook。",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "email": {
          "$ref": "#/$defs/authDeliveryChannel"
        },
        "sms": {
          "$ref": "#/$defs/authDeliveryChannel"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "sms"
            ]
          },
          "then": {
            "properties": {
              "sms": {
                "properties": {
                  "kind": {
                    "const": "webhook"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "authDeliveryChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "smtp",
            "webhook"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "$ref": "#/$defs/hostPort"
        },
        "from": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320,
          "description": "SMTP 信封发件人与 From 头地址。"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "passwordRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "SMTP 密码的秘密引用名；值只能来自 authentication.secretsFile 映射，不得内联。"
        },
        "tlsMode": {
          "enum": [
            "starttls",
            "implicit"
          ],
          "default": "starttls",
          "description": "TLS 必选；starttls 表示服务器必须提供 STARTTLS，implicit 表示从首字节即 TLS。无明文投递选项。"
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "minLength": 8,
          "maxLength": 2048,
          "description": "webhook 的唯一固定目标；必须 HTTPS，不得包含占位符或 userinfo。"
        },
        "headers": {
          "$ref": "#/$defs/authDeliveryHeaders"
        },
        "secretHeaders": {
          "$ref": "#/$defs/authDeliverySecretHeaders"
        },
        "encoding": {
          "enum": [
            "json",
            "form"
          ],
          "default": "json"
        },
        "fields": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096,
            "description": "受限字段映射：值只能是字面量与固定占位符（{delivery_id} {channel} {recipient} {template} {code} {expires_in_seconds} {metadata.KEY}），不是可执行模板。"
          }
        },
        "successField": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "可选的 2xx 业务成功判定 JSON 字段路径（最多 4 层）。"
        },
        "successValue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "successField 的期望 JSON 字面量（字符串、数字或布尔）。"
        },
        "allowPrivateCIDRs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
          },
          "description": "显式允许的私网网段；link-local/元数据地址即使被列出也永远拒绝。"
        },
        "rootCaPem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "description": "PEM 编码的附加 CA，只追加到系统信任池，不替代公共校验。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "smtp"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "host",
              "port",
              "from"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "webhook"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "required": [
              "successField"
            ]
          },
          "then": {
            "required": [
              "successValue"
            ]
          }
        },
        {
          "if": {
            "required": [
              "successValue"
            ]
          },
          "then": {
            "required": [
              "successField"
            ]
          }
        },
        {
          "if": {
            "required": [
              "username"
            ]
          },
          "then": {
            "required": [
              "passwordRef"
            ]
          }
        },
        {
          "if": {
            "required": [
              "passwordRef"
            ]
          },
          "then": {
            "required": [
              "username"
            ]
          }
        }
      ]
    },
    "authDeliveryHeaders": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "authDeliverySecretHeaders": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "请求头名→秘密引用名；值来自 authentication.secretsFile 映射，不得内联。"
      }
    },
    "quoinAudit": {
      "description": "审计保留期（ADR-0006）：默认且最低六个自然月，部署只能延长；省略整节保持默认。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retentionMonths"
      ],
      "properties": {
        "retentionMonths": {
          "type": "integer",
          "minimum": 6,
          "maximum": 240
        }
      }
    },
    "plinthConfig": {
      "$anchor": "plinthConfig",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "stateDirectory",
        "workspaceDirectory",
        "quoinRuntimeEndpoint",
        "quoinRuntimeCaFile",
        "quoinRuntimeClientCertificateFile",
        "quoinRuntimeClientPrivateKeyFile"
      ],
      "properties": {
        "component": {
          "const": "plinth"
        },
        "stateDirectory": {
          "$ref": "#/$defs/absolutePath"
        },
        "workspaceDirectory": {
          "$ref": "#/$defs/absolutePath"
        },
        "quoinRuntimeEndpoint": {
          "$ref": "#/$defs/quoinRuntimeEndpoint"
        },
        "quoinRuntimeCaFile": {
          "$ref": "#/$defs/absolutePath"
        },
        "enabledPlugins": {
          "$ref": "#/$defs/enabledPlugins",
          "description": "必须与 quoinConfig.enabledPlugins 保持同一部署输入一致。Plinth 不按本字段渲染目录：worker 从 attempt 冻结输入快照内嵌的工具目录渲染，Quoin 在 BeginModelCall 校验摘要；本字段是部署一致性声明，实际目录传输不经此字段。"
        },
        "quoinRuntimeClientCertificateFile": {
          "$ref": "#/$defs/absolutePath",
          "description": "部署 CA 签发的 Plinth 客户端证书（CN=plinth）；mTLS 身份，替代已退役的注册令牌（ADR-0009）。"
        },
        "quoinRuntimeClientPrivateKeyFile": {
          "$ref": "#/$defs/absolutePath",
          "description": "Plinth 客户端证书私钥；只读挂载的部署 Secret。"
        }
      }
    },
    "steleConfig": {
      "$anchor": "steleConfig",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "quoinRuntimeEndpoint",
        "quoinRuntimeCaFile",
        "quoinRuntimeClientCertificateFile",
        "quoinRuntimeClientPrivateKeyFile"
      ],
      "properties": {
        "component": {
          "const": "stele"
        },
        "quoinRuntimeEndpoint": {
          "$ref": "#/$defs/quoinRuntimeEndpoint"
        },
        "quoinRuntimeCaFile": {
          "$ref": "#/$defs/absolutePath"
        },
        "quoinRuntimeClientCertificateFile": {
          "$ref": "#/$defs/absolutePath",
          "description": "部署 CA 签发的 Stele 客户端证书（CN=stele）；mTLS 身份，替代已退役的 service token（ADR-0009）。"
        },
        "quoinRuntimeClientPrivateKeyFile": {
          "$ref": "#/$defs/absolutePath",
          "description": "Stele 客户端证书私钥；只读挂载的部署 Secret。"
        }
      }
    }
  }
}

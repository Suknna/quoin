{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Suknna/quoin/schemas/deployment-config.schema.json",
  "x-quoin-contract-version": 1,
  "title": "Quoin v1 deployment inputs and component configuration",
  "description": "OPS-CONFIG-001..004 的唯一机器权威。根 oneOf 同时校验 Helm/Compose 人类最少输入与四组件生成配置；不包含 Admin Web UI 设置、镜像版本、replica/HPA、内部监听地址或内部端口。",
  "oneOf": [
    { "$ref": "#/$defs/helmInstallInput" },
    { "$ref": "#/$defs/composeInstallInput" },
    { "$ref": "#/$defs/quoinConfig" },
    { "$ref": "#/$defs/plinthConfig" },
    { "$ref": "#/$defs/lintelConfig" },
    { "$ref": "#/$defs/steleConfig" }
  ],
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "publicOrigin": {
      "type": "string",
      "description": "规范公共 Origin；仅 scheme + authority，无 path/query/fragment。",
      "pattern": "^https://(?:\\[[0-9A-Fa-f:]+\\]|[^/?#:\\s]+)(?::[0-9]{1,5})?$",
      "maxLength": 512
    },
    "quoinRuntimeEndpoint": {
      "type": "string",
      "description": "Runtime/Stele 拨号的 Quoin TLS gRPC endpoint；这是远端地址，不是本进程监听配置。",
      "pattern": "^https://(?:\\[[0-9A-Fa-f:]+\\]|[^/?#:\\s]+):[0-9]{1,5}$",
      "maxLength": 512
    },
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
    },
    "hostPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "kubernetesQuantity": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:Mi|Gi|Ti)$"
    },
    "pvcInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "accessMode"],
      "properties": {
        "capacity": { "$ref": "#/$defs/kubernetesQuantity" },
        "accessMode": { "enum": ["ReadWriteOncePod", "ReadWriteOnce"] },
        "storageClassName": { "$ref": "#/$defs/dnsLabel" }
      }
    },
    "ingressInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "$ref": "#/$defs/dnsLabel" },
        "host": { "type": "string", "format": "hostname" },
        "tlsSecretName": { "$ref": "#/$defs/dnsLabel" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "required": ["className", "host", "tlsSecretName"] },
          "else": { "not": { "anyOf": [{ "required": ["className"] }, { "required": ["host"] }, { "required": ["tlsSecretName"] }] } }
        }
      ]
    },
    "resourceQuantityPair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 }
      },
      "minProperties": 1
    },
    "resourceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "$ref": "#/$defs/resourceQuantityPair" },
        "limits": { "$ref": "#/$defs/resourceQuantityPair" }
      },
      "minProperties": 1
    },
    "componentResources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quoin": { "$ref": "#/$defs/resourceRequirements" },
        "plinth": { "$ref": "#/$defs/resourceRequirements" },
        "lintel": { "$ref": "#/$defs/resourceRequirements" },
        "stele": { "$ref": "#/$defs/resourceRequirements" }
      },
      "minProperties": 1
    },
    "helmInstallInput": {
      "$anchor": "helmInstallInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "publicOrigin", "publicIngress", "steleIngress", "storage", "lintelBrowserSlots"],
      "properties": {
        "document": { "const": "helm-install" },
        "publicOrigin": { "$ref": "#/$defs/publicOrigin" },
        "publicIngress": { "$ref": "#/$defs/ingressInput" },
        "steleIngress": { "$ref": "#/$defs/ingressInput" },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quoinData", "quoinBackup", "plinthState", "lintelState"],
          "properties": {
            "quoinData": { "$ref": "#/$defs/pvcInput" },
            "quoinBackup": { "$ref": "#/$defs/pvcInput" },
            "plinthState": { "$ref": "#/$defs/pvcInput" },
            "lintelState": { "$ref": "#/$defs/pvcInput" }
          }
        },
        "lintelBrowserSlots": { "type": "integer", "minimum": 1 },
        "lintelShmSize": { "$ref": "#/$defs/kubernetesQuantity", "default": "1Gi" },
        "opsServiceAnnotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "monitorDiscovery": { "enum": ["none", "serviceMonitor", "podMonitor"], "default": "none" },
        "prometheusRule": { "type": "boolean", "default": false },
        "resources": { "$ref": "#/$defs/componentResources" }
      }
    },
    "composeInstallInput": {
      "$anchor": "composeInstallInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "publicOrigin", "publishMode", "secretDirectory", "lintelBrowserSlots"],
      "properties": {
        "document": { "const": "compose-install" },
        "publicOrigin": { "$ref": "#/$defs/publicOrigin" },
        "publishMode": { "enum": ["loopback", "internal-network-only"] },
        "quoinPublicHostPort": { "$ref": "#/$defs/hostPort" },
        "steleWebhookHostPort": { "$ref": "#/$defs/hostPort" },
        "externalProxyNetwork": { "type": "string", "minLength": 1, "maxLength": 255 },
        "secretDirectory": { "$ref": "#/$defs/absolutePath" },
        "lintelBrowserSlots": { "type": "integer", "minimum": 1 },
        "lintelShmSizeBytes": { "type": "integer", "minimum": 1, "default": 1073741824 }
      },
      "allOf": [
        {
          "if": { "properties": { "publishMode": { "const": "loopback" } } },
          "then": {
            "required": ["quoinPublicHostPort", "steleWebhookHostPort"],
            "not": { "required": ["externalProxyNetwork"] }
          },
          "else": {
            "required": ["externalProxyNetwork"],
            "not": { "anyOf": [{ "required": ["quoinPublicHostPort"] }, { "required": ["steleWebhookHostPort"] }] }
          }
        }
      ]
    },
    "deploymentBinding": {
      "description": "安装/升级时冻结的不可变部署绑定；Quoin 启动时校验并只读，Deployment Acceptance 以它作为站点 release subject 与部署配置的权威绑定。本地开发投影省略该字段，此时 Deployment Acceptance 不可用。",
      "additionalProperties": false,
      "required": ["releaseVersion", "releaseSubjectDigest", "deploymentConfigDigest", "backend", "architecture", "browserChromiumRevision"],
      "properties": {
        "releaseVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "releaseSubjectDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "deploymentConfigDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "backend": { "enum": ["compose", "kubernetes"] },
        "architecture": { "enum": ["linux/amd64", "linux/arm64"] },
        "browserChromiumRevision": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "quoinConfig": {
      "$anchor": "quoinConfig",
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "publicOrigin", "dataDirectory", "backupDirectory", "rootKeyFile", "runtimeTlsCertificateFile", "runtimeTlsPrivateKeyFile", "steleServiceTokenFile"],
      "properties": {
        "component": { "const": "quoin" },
        "publicOrigin": { "$ref": "#/$defs/publicOrigin" },
        "dataDirectory": { "$ref": "#/$defs/absolutePath" },
        "backupDirectory": { "$ref": "#/$defs/absolutePath" },
        "rootKeyFile": { "$ref": "#/$defs/absolutePath" },
        "runtimeTlsCertificateFile": { "$ref": "#/$defs/absolutePath" },
        "runtimeTlsPrivateKeyFile": { "$ref": "#/$defs/absolutePath" },
        "steleServiceTokenFile": { "$ref": "#/$defs/absolutePath" },
        "deploymentBinding": { "$ref": "#/$defs/deploymentBinding" }
      }
    },
    "plinthConfig": {
      "$anchor": "plinthConfig",
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "stateDirectory", "workspaceDirectory", "quoinRuntimeEndpoint", "quoinRuntimeCaFile"],
      "properties": {
        "component": { "const": "plinth" },
        "stateDirectory": { "$ref": "#/$defs/absolutePath" },
        "workspaceDirectory": { "$ref": "#/$defs/absolutePath" },
        "quoinRuntimeEndpoint": { "$ref": "#/$defs/quoinRuntimeEndpoint" },
        "quoinRuntimeCaFile": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "lintelConfig": {
      "$anchor": "lintelConfig",
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "stateDirectory", "quoinRuntimeEndpoint", "quoinRuntimeCaFile", "browserSlots", "minimumShmBytes"],
      "properties": {
        "component": { "const": "lintel" },
        "stateDirectory": { "$ref": "#/$defs/absolutePath" },
        "quoinRuntimeEndpoint": { "$ref": "#/$defs/quoinRuntimeEndpoint" },
        "quoinRuntimeCaFile": { "$ref": "#/$defs/absolutePath" },
        "browserSlots": { "type": "integer", "minimum": 1, "description": "固定浏览器容量；同一 boot 不得变化。" },
        "minimumShmBytes": { "type": "integer", "minimum": 67108864, "description": "由 Helm lintelShmSize 或 Compose lintelShmSizeBytes 机械投影；Lintel 启动时据此验证 /dev/shm。" }
      }
    },
    "steleConfig": {
      "$anchor": "steleConfig",
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "quoinRuntimeEndpoint", "quoinRuntimeCaFile", "serviceTokenFile"],
      "properties": {
        "component": { "const": "stele" },
        "quoinRuntimeEndpoint": { "$ref": "#/$defs/quoinRuntimeEndpoint" },
        "quoinRuntimeCaFile": { "$ref": "#/$defs/absolutePath" },
        "serviceTokenFile": { "$ref": "#/$defs/absolutePath" }
      }
    }
  }
}

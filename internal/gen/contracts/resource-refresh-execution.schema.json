{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Suknna/quoin/schemas/resource-refresh-execution.schema.json",
  "title": "Quoin Resource Refresh Execution Contracts",
  "description": "已发布配置的 Resource Discovery supervisor-only PromQL 输入与结果；唯一凭据路径为 config_thanos_query Attempt grant。",
  "oneOf": [
    { "$ref": "#/$defs/input" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "locatorId": { "type": "integer", "minimum": 1 },
    "dateTime": { "type": "string", "format": "date-time", "minLength": 1, "maxLength": 100 },
    "labels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "maxLength": 10000 }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaKind", "attemptId", "resourceRefreshRunId", "configVersionId", "discoveryKey", "selector", "identityLabels", "grantId"],
      "properties": {
        "schemaKind": { "const": "resource_refresh_execution_v1" },
        "attemptId": { "$ref": "#/$defs/locatorId" },
        "resourceRefreshRunId": { "$ref": "#/$defs/locatorId" },
        "configVersionId": { "$ref": "#/$defs/locatorId" },
        "discoveryKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "selector": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "identityLabels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "uniqueItems": true
        },
        "grantId": { "$ref": "#/$defs/locatorId" }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "value", "timestamp"],
      "properties": {
        "labels": { "$ref": "#/$defs/labels" },
        "value": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "timestamp": { "type": "number" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaKind", "attemptId", "resourceRefreshRunId", "discoveryKey", "outcome", "observedAt", "series", "warnings", "errors", "gapReason"],
      "properties": {
        "schemaKind": { "const": "resource_discovery_result_v1" },
        "attemptId": { "$ref": "#/$defs/locatorId" },
        "resourceRefreshRunId": { "$ref": "#/$defs/locatorId" },
        "discoveryKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "outcome": { "enum": ["success", "error", "gap"] },
        "observedAt": { "$ref": "#/$defs/dateTime" },
        "series": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/series" } },
        "warnings": { "type": "array", "maxItems": 1000, "items": { "type": "string", "maxLength": 10000 } },
        "errors": { "type": "array", "maxItems": 1000, "items": { "type": "string", "maxLength": 10000 } },
        "gapReason": { "oneOf": [{ "enum": ["query_failed", "partial_response", "cancelled", "interrupted"] }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "success" } }, "required": ["outcome"] },
          "then": { "properties": { "errors": { "maxItems": 0 }, "gapReason": { "type": "null" } } },
          "else": { "properties": { "series": { "maxItems": 0 }, "gapReason": { "type": "string" } } }
        }
      ]
    }
  }
}

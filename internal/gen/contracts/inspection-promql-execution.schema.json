{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Suknna/quoin/schemas/inspection-promql-execution.schema.json",
  "title": "Quoin Inspection Run PromQL Execution Contracts",
  "description": "Manual or scheduled Inspection Run 的 Plinth supervisor PromQL 采集输入与结果。唯一凭据路径为 config_thanos_query Attempt grant；worker 与模型永不参与。",
  "oneOf": [
    { "$ref": "#/$defs/input" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "locatorId": { "type": "integer", "minimum": 1 },
    "dateTime": { "type": "string", "format": "date-time", "minLength": 1, "maxLength": 100 },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaKind", "attemptId", "inspectionRunId", "checkKey", "evidenceAt", "query", "grantId"],
      "properties": {
        "schemaKind": { "const": "inspection_promql_execution_v1" },
        "attemptId": { "$ref": "#/$defs/locatorId" },
        "inspectionRunId": { "$ref": "#/$defs/locatorId" },
        "checkKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "evidenceAt": { "$ref": "#/$defs/dateTime" },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "expression", "rangeSeconds", "stepSeconds"],
          "properties": {
            "mode": { "enum": ["instant", "range"] },
            "expression": { "type": "string", "minLength": 1, "maxLength": 100000 },
            "rangeSeconds": { "type": ["integer", "null"], "minimum": 1 },
            "stepSeconds": { "type": ["integer", "null"], "minimum": 1 }
          },
          "allOf": [
            {
              "if": { "properties": { "mode": { "const": "instant" } }, "required": ["mode"] },
              "then": { "properties": { "rangeSeconds": { "type": "null" }, "stepSeconds": { "type": "null" } } },
              "else": { "required": ["rangeSeconds", "stepSeconds"], "properties": { "rangeSeconds": { "type": "integer", "minimum": 1 }, "stepSeconds": { "type": "integer", "minimum": 1 } } }
            }
          ]
        },
        "grantId": { "$ref": "#/$defs/locatorId" }
      }
    },
    "sample": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": ["number", "string"] },
        { "type": "string", "minLength": 1 }
      ],
      "items": false
    },
    "metric": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 10000 }
    },
    "vectorSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value"],
      "properties": {
        "metric": { "$ref": "#/$defs/metric" },
        "value": { "$ref": "#/$defs/sample" }
      }
    },
    "matrixSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "values"],
      "properties": {
        "metric": { "$ref": "#/$defs/metric" },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sample" }
        }
      }
    },
    "prometheusResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultType", "result"],
      "properties": {
        "resultType": { "enum": ["vector", "matrix", "scalar", "string"] },
        "result": {}
      },
      "allOf": [
        {
          "if": { "properties": { "resultType": { "const": "vector" } }, "required": ["resultType"] },
          "then": { "properties": { "result": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/vectorSample" } } } }
        },
        {
          "if": { "properties": { "resultType": { "const": "matrix" } }, "required": ["resultType"] },
          "then": { "properties": { "result": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/matrixSeries" } } } }
        },
        {
          "if": { "properties": { "resultType": { "enum": ["scalar", "string"] } }, "required": ["resultType"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/sample" } } }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaKind", "attemptId", "inspectionRunId", "checkKey", "queryMode", "outcome", "observedAt", "executionWindow", "result", "warnings", "errors", "gapReason"],
      "properties": {
        "schemaKind": { "const": "inspection_promql_result_v1" },
        "attemptId": { "$ref": "#/$defs/locatorId" },
        "inspectionRunId": { "$ref": "#/$defs/locatorId" },
        "checkKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "queryMode": { "enum": ["instant", "range"] },
        "outcome": { "enum": ["success", "error", "gap"] },
        "observedAt": { "$ref": "#/$defs/dateTime" },
        "executionWindow": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["startAt", "endAt", "stepSeconds"],
              "properties": {
                "startAt": { "$ref": "#/$defs/dateTime" },
                "endAt": { "$ref": "#/$defs/dateTime" },
                "stepSeconds": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "result": { "oneOf": [{ "$ref": "#/$defs/prometheusResult" }, { "type": "null" }] },
        "warnings": { "type": "array", "maxItems": 1000, "items": { "type": "string", "maxLength": 10000 } },
        "errors": { "type": "array", "maxItems": 1000, "items": { "type": "string", "maxLength": 10000 } },
        "gapReason": { "oneOf": [{ "enum": ["query_failed", "partial_response", "no_data", "cancelled", "interrupted"] }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "queryMode": { "const": "instant" } }, "required": ["queryMode"] },
          "then": { "properties": { "executionWindow": { "type": "null" } } },
          "else": { "properties": { "executionWindow": { "type": "object" } } }
        },
        {
          "if": { "properties": { "outcome": { "const": "success" } }, "required": ["outcome"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/prometheusResult" }, "errors": { "maxItems": 0 }, "gapReason": { "type": "null" } } },
          "else": { "properties": { "result": { "type": "null" }, "gapReason": { "type": "string" } } }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Suknna/quoin/schemas/connection-probes.schema.json",
  "x-quoin-contract-version": 1,
  "title": "Quoin v1 Connection Probe action catalog",
  "type": "object",
  "required": ["contract_version", "catalog_id", "closed_action_sets", "connection_types"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "const": 1 },
    "catalog_id": { "const": "connection-probes-v1" },
    "closed_action_sets": { "const": true },
    "connection_types": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["type", "action_set_id", "action_set_version", "executor", "actions", "pass_expression"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["model_provider", "thanos", "kubernetes"] },
          "action_set_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]+$" },
          "action_set_version": { "const": 1 },
          "executor": { "const": "plinth_supervisor" },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "operation_kind", "operation", "request", "side_effect", "assertions"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]+$" },
                "operation_kind": { "enum": ["model_chat_stream", "model_native_tool_call", "model_parallel_tool_calls", "model_cancel", "model_usage_request_id", "model_embedding", "prometheus_query", "http_get", "self_subject_access_review"] },
                "operation": { "type": "string", "minLength": 1 },
                "request": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "profile": { "type": "string", "minLength": 1 },
                    "method": { "enum": ["GET", "POST"] },
                    "path": { "type": "string", "minLength": 1 },
                    "query": { "type": "string", "minLength": 1 },
                    "namespace_resolution": { "const": "defaultNamespace_then_currentContext_then_default" },
                    "group": { "type": "string" },
                    "resource": { "type": "string", "minLength": 1 },
                    "subresource": { "type": "string" },
                    "verb": { "enum": ["get", "list"] }
                  }
                },
                "side_effect": { "enum": ["none", "provider_ephemeral_request"] },
                "assertions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              }
            }
          },
          "pass_expression": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

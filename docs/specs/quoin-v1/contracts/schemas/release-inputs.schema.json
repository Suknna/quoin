{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Suknna/quoin/schemas/release-inputs.schema.json",
  "title": "Quoin release input lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "architectures", "base_images", "component_bases"],
  "properties": {
    "contract_version": { "const": 1 },
    "architectures": {
      "type": "array",
      "const": ["linux/amd64", "linux/arm64"]
    },
    "base_images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["debian13_slim", "distroless_static_debian13_nonroot"],
      "properties": {
        "debian13_slim": { "$ref": "#/$defs/multiPlatformInput" },
        "distroless_static_debian13_nonroot": { "$ref": "#/$defs/multiPlatformInput" }
      }
    },
    "component_bases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quoin", "plinth", "stele"],
      "properties": {
        "quoin": { "const": "distroless_static_debian13_nonroot" },
        "plinth": { "const": "debian13_slim" },
        "stele": { "const": "distroless_static_debian13_nonroot" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "multiPlatformInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source_tag", "index_digest", "platforms"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "source_tag": { "type": "string", "minLength": 1 },
        "index_digest": { "$ref": "#/$defs/sha256" },
        "platforms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linux/amd64", "linux/arm64"],
          "properties": {
            "linux/amd64": { "$ref": "#/$defs/sha256" },
            "linux/arm64": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Suknna/quoin/schemas/deployment-config.schema.json",
  "x-quoin-contract-version": 1,
  "title": "Quoin v1 deployment inputs and component configuration",
  "description": "OPS-CONFIG-001..004 的唯一机器权威。根 oneOf 校验四组件进程配置及 Compose 验证辅助输入；Kubernetes 直接使用普通 YAML；不包含 Admin Web UI 设置、镜像版本、replica/HPA、内部监听地址或内部端口。",
  "oneOf": [
    {
      "$ref": "#/$defs/composeInstallInput"
    },
    {
      "$ref": "#/$defs/quoinConfig"
    },
    {
      "$ref": "#/$defs/plinthConfig"
    },
    {
      "$ref": "#/$defs/steleConfig"
    }
  ],
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "publicOrigin": {
      "type": "string",
      "description": "规范公共 Origin；仅 scheme + authority，无 path/query/fragment。",
      "pattern": "^https://(?:\\[[0-9A-Fa-f:]+\\]|[^/?#:\\s]+)(?::[0-9]{1,5})?$",
      "maxLength": 512
    },
    "stelePublicURL": {
      "type": "string",
      "description": "Alertmanager 到 Stele 的部署公开 receiver URL；必须是 HTTPS 且固定为 /stele/alerts，不从请求 Host 推导。",
      "pattern": "^https://(?:\\[[0-9A-Fa-f:]+\\]|[^/?#:\\s]+)(?::[0-9]{1,5})?/stele/alerts$",
      "maxLength": 512
    },
    "quoinRuntimeEndpoint": {
      "type": "string",
      "description": "Runtime/Stele 拨号的 Quoin TLS gRPC endpoint；这是远端地址，不是本进程监听配置。",
      "pattern": "^https://(?:\\[[0-9A-Fa-f:]+\\]|[^/?#:\\s]+):[0-9]{1,5}$",
      "maxLength": 512
    },
    "hostPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "enabledPlugins": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "composeInstallInput": {
      "$anchor": "composeInstallInput",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "publicOrigin",
        "publishMode",
        "secretDirectory"
      ],
      "properties": {
        "document": {
          "const": "compose-install"
        },
        "publicOrigin": {
          "$ref": "#/$defs/publicOrigin"
        },
        "publishMode": {
          "enum": [
            "loopback",
            "internal-network-only"
          ]
        },
        "quoinPublicHostPort": {
          "$ref": "#/$defs/hostPort"
        },
        "steleWebhookHostPort": {
          "$ref": "#/$defs/hostPort"
        },
        "externalProxyNetwork": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "secretDirectory": {
          "$ref": "#/$defs/absolutePath"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "publishMode": {
                "const": "loopback"
              }
            }
          },
          "then": {
            "required": [
              "quoinPublicHostPort",
              "steleWebhookHostPort"
            ],
            "not": {
              "required": [
                "externalProxyNetwork"
              ]
            }
          },
          "else": {
            "required": [
              "externalProxyNetwork"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "quoinPublicHostPort"
                  ]
                },
                {
                  "required": [
                    "steleWebhookHostPort"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "deploymentBinding": {
      "description": "安装/升级时冻结的不可变部署绑定；Quoin 启动时校验并只读，Deployment Acceptance 以它作为站点 release subject 与部署配置的权威绑定。本地开发投影省略该字段，此时 Deployment Acceptance 不可用。",
      "additionalProperties": false,
      "required": [
        "releaseVersion",
        "releaseSubjectDigest",
        "deploymentConfigDigest",
        "backend",
        "architecture"
      ],
      "properties": {
        "releaseVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "releaseSubjectDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "deploymentConfigDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "backend": {
          "enum": [
            "compose",
            "kubernetes"
          ]
        },
        "architecture": {
          "enum": [
            "linux/amd64",
            "linux/arm64"
          ]
        }
      }
    },
    "quoinConfig": {
      "$anchor": "quoinConfig",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "publicOrigin",
        "dataDirectory",
        "backupDirectory",
        "rootKeyFile",
        "runtimeTlsCertificateFile",
        "runtimeTlsPrivateKeyFile",
        "runtimeClientCaFile"
      ],
      "properties": {
        "component": {
          "const": "quoin"
        },
        "publicOrigin": {
          "$ref": "#/$defs/publicOrigin"
        },
        "dataDirectory": {
          "$ref": "#/$defs/absolutePath"
        },
        "backupDirectory": {
          "$ref": "#/$defs/absolutePath"
        },
        "rootKeyFile": {
          "$ref": "#/$defs/absolutePath"
        },
        "runtimeTlsCertificateFile": {
          "$ref": "#/$defs/absolutePath"
        },
        "runtimeTlsPrivateKeyFile": {
          "$ref": "#/$defs/absolutePath"
        },
        "stelePublicURL": {
          "$ref": "#/$defs/stelePublicURL"
        },
        "deploymentBinding": {
          "$ref": "#/$defs/deploymentBinding"
        },
        "enabledPlugins": {
          "$ref": "#/$defs/enabledPlugins",
          "description": "显式插件启用白名单（ADR-0004）。字段省略=启用全部 DefaultEnabled 插件（prometheus/thanos/alertmanager）；显式空数组=全部停用——省略与空数组是不同的部署事实。未知插件 ID 使组件启动失败。"
        },
        "authentication": {
          "$ref": "#/$defs/quoinAuthentication"
        },
        "audit": {
          "$ref": "#/$defs/quoinAudit"
        },
        "runtimeClientCaFile": {
          "$ref": "#/$defs/absolutePath",
          "description": "签发客户端证书的部署 CA 证书（runtime-ca.pem）；Runtime gRPC 监听以它校验 mTLS 客户端证书。"
        }
      }
    },
    "quoinAuthentication": {
      "description": "登录通道声明（ADR-0010 统一认证设计第 4 节）。local 省略时启用且可见；visible=false 仅隐藏登录页本地表单，POST /api/v1/auth/login 与 /login?local=1 仍可用（应急通道）。oidc 省略或 enabled=false 时关闭；启用时 issuer/clientId/redirectUrl 必填，client_secret 只经 secretsFile 引用文件提供，绝不写入本文件。local.enabled 与 oidc.enabled 同时为 false 的配置在组件启动时被拒绝。",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "local": {
          "type": "object",
          "description": "本地应急登录通道；省略整个键等价于 enabled=true, visible=true。",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "本地密码登录是否可用；默认 true。"
            },
            "visible": {
              "type": "boolean",
              "description": "登录页是否渲染本地表单；默认 true。仅控制展示，不关闭接口。"
            }
          }
        },
        "oidc": {
          "type": "object",
          "description": "通用 OIDC 授权码通道（ADR-0010）；enabled 默认 false。",
          "additionalProperties": false,
          "required": ["issuer", "clientId", "redirectUrl"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "是否启用 OIDC 登录；默认 false。"
            },
            "issuer": {
              "type": "string",
              "minLength": 8,
              "maxLength": 512,
              "description": "OIDC issuer；发现文档经 /.well-known/openid-configuration 自动获取。"
            },
            "clientId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "OIDC client id。"
            },
            "redirectUrl": {
              "type": "string",
              "minLength": 8,
              "maxLength": 512,
              "description": "回调地址，通常为 <公共源>/api/v1/auth/oidc/callback。"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "SSO 按钮显示名；缺省用 issuer 主机名。"
            },
            "iconUrl": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "SSO 按钮图标 URL；可选。"
            }
          }
        },
        "secretsFile": {
          "$ref": "#/$defs/absolutePath",
          "description": "只读秘密引用文件（引用名→值，JSON 或 YAML）；oidc client_secret 以引用名 oidcClientSecret 提供。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "oidc": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            },
            "required": ["oidc"]
          },
          "then": {
            "required": ["secretsFile"]
          }
        }
      ]
    },
    "quoinAudit": {
      "description": "审计保留期（ADR-0006）：默认且最低六个自然月，部署只能延长；省略整节保持默认。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retentionMonths"
      ],
      "properties": {
        "retentionMonths": {
          "type": "integer",
          "minimum": 6,
          "maximum": 240
        }
      }
    },
    "plinthConfig": {
      "$anchor": "plinthConfig",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "stateDirectory",
        "workspaceDirectory",
        "quoinRuntimeEndpoint",
        "quoinRuntimeCaFile",
        "quoinRuntimeClientCertificateFile",
        "quoinRuntimeClientPrivateKeyFile"
      ],
      "properties": {
        "component": {
          "const": "plinth"
        },
        "stateDirectory": {
          "$ref": "#/$defs/absolutePath"
        },
        "workspaceDirectory": {
          "$ref": "#/$defs/absolutePath"
        },
        "quoinRuntimeEndpoint": {
          "$ref": "#/$defs/quoinRuntimeEndpoint"
        },
        "quoinRuntimeCaFile": {
          "$ref": "#/$defs/absolutePath"
        },
        "enabledPlugins": {
          "$ref": "#/$defs/enabledPlugins",
          "description": "必须与 quoinConfig.enabledPlugins 保持同一部署输入一致。Plinth 不按本字段渲染目录：worker 从 attempt 冻结输入快照内嵌的工具目录渲染，Quoin 在 BeginModelCall 校验摘要；本字段是部署一致性声明，实际目录传输不经此字段。"
        },
        "quoinRuntimeClientCertificateFile": {
          "$ref": "#/$defs/absolutePath",
          "description": "部署 CA 签发的 Plinth 客户端证书（CN=plinth）；mTLS 身份，替代已退役的注册令牌（ADR-0009）。"
        },
        "quoinRuntimeClientPrivateKeyFile": {
          "$ref": "#/$defs/absolutePath",
          "description": "Plinth 客户端证书私钥；只读挂载的部署 Secret。"
        }
      }
    },
    "steleConfig": {
      "$anchor": "steleConfig",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "quoinRuntimeEndpoint",
        "quoinRuntimeCaFile",
        "quoinRuntimeClientCertificateFile",
        "quoinRuntimeClientPrivateKeyFile"
      ],
      "properties": {
        "component": {
          "const": "stele"
        },
        "quoinRuntimeEndpoint": {
          "$ref": "#/$defs/quoinRuntimeEndpoint"
        },
        "quoinRuntimeCaFile": {
          "$ref": "#/$defs/absolutePath"
        },
        "quoinRuntimeClientCertificateFile": {
          "$ref": "#/$defs/absolutePath",
          "description": "部署 CA 签发的 Stele 客户端证书（CN=stele）；mTLS 身份，替代已退役的 service token（ADR-0009）。"
        },
        "quoinRuntimeClientPrivateKeyFile": {
          "$ref": "#/$defs/absolutePath",
          "description": "Stele 客户端证书私钥；只读挂载的部署 Secret。"
        }
      }
    }
  }
}

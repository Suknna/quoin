{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Suknna/quoin/schemas/config-verification-discovery-execution.schema.json",
  "title":"Config Verification Discovery Execution",
  "oneOf":[{"$ref":"#/$defs/input"},{"$ref":"#/$defs/result"}],
  "$defs":{
    "id":{"type":"integer","minimum":1},
    "labels":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","maxLength":10000}},
    "series":{"type":"object","additionalProperties":false,"required":["labels","value","timestamp"],"properties":{"labels":{"$ref":"#/$defs/labels"},"value":{"type":"string","minLength":1,"maxLength":10000},"timestamp":{"type":"number"}}},
    "input":{"type":"object","additionalProperties":false,"required":["schemaKind","attemptId","verificationRunId","discoveryKey","selector","identityLabels","grantId"],"properties":{"schemaKind":{"const":"config_verification_discovery_execution_v1"},"attemptId":{"$ref":"#/$defs/id"},"verificationRunId":{"$ref":"#/$defs/id"},"discoveryKey":{"type":"string","minLength":1,"maxLength":200},"selector":{"type":"string","minLength":1,"maxLength":100000},"identityLabels":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":200}},"grantId":{"$ref":"#/$defs/id"}}},
    "result":{"type":"object","additionalProperties":false,"required":["schemaKind","attemptId","verificationRunId","discoveryKey","outcome","observedAt","series","warnings","errors","gapReason"],"properties":{"schemaKind":{"const":"config_verification_discovery_result_v1"},"attemptId":{"$ref":"#/$defs/id"},"verificationRunId":{"$ref":"#/$defs/id"},"discoveryKey":{"type":"string","minLength":1,"maxLength":200},"outcome":{"enum":["success","error","gap"]},"observedAt":{"type":"string","format":"date-time","minLength":1,"maxLength":100},"series":{"type":"array","minItems":0,"maxItems":100000,"items":{"$ref":"#/$defs/series"}},"warnings":{"type":"array","maxItems":1000,"items":{"type":"string","maxLength":10000}},"errors":{"type":"array","maxItems":1000,"items":{"type":"string","maxLength":10000}},"gapReason":{"oneOf":[{"enum":["query_failed","partial_response","no_data","cancelled","interrupted"]},{"type":"null"}]}},"allOf":[{"if":{"properties":{"outcome":{"const":"success"}},"required":["outcome"]},"then":{"properties":{"series":{"minItems":1},"warnings":{"maxItems":0},"errors":{"maxItems":0},"gapReason":{"type":"null"}}},"else":{"properties":{"series":{"maxItems":0},"gapReason":{"type":"string"}}}}]}
  }
}

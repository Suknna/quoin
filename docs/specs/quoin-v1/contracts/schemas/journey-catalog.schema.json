{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Suknna/quoin/schemas/journey-catalog.schema.json",
  "title": "Journey Catalog Document",
  "description": "由 Lintel 版本化 Playwright Journey 的单一机器来源生成并由 Quoin/Lintel 同字节嵌入的 catalog。每个稳定 Journey ID 同时声明参数、输出、Evidence 与实现版本契约；该文档原始 JCS 字节的 SHA-256 是握手和历史绑定使用的 catalog digest（CFG-JOURNEY-001..005）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "journeys"],
  "properties": {
    "catalog_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "journeys": {
      "type": "object",
      "description": "以版本化稳定 journey_id 为键的映射；生成器按 key 稳定排序。",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/journeyEntry"
      }
    }
  },
  "$defs": {
    "journeyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "purpose",
        "version",
        "steps_digest",
        "params_schema",
        "output_schema",
        "evidence_kinds"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "purpose": {
          "type": "string",
          "enum": ["journey", "authentication_probe"]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "同一稳定 ID 下实现步骤变化时单调递增；相同 version 的 steps_digest 不得改写。"
        },
        "steps_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "生成器从不可变 Playwright step definition 计算的 SHA-256；catalog 不暴露用户可编程脚本。"
        },
        "params_schema": {
          "$ref": "#/$defs/selfContainedObjectSchema"
        },
        "output_schema": {
          "$ref": "#/$defs/selfContainedObjectSchema"
        },
        "evidence_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["text", "structured", "screenshot"]
          },
          "description": "普通 Journey 必须允许 structured；成功结果中唯一 primary structured Evidence 的 content 是 output_schema 的唯一权威实例。authentication probe 固定为空，其三态结果只进入 browser_probe_results。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "purpose": { "const": "authentication_probe" } },
            "required": ["purpose"]
          },
          "then": {
            "properties": {
              "evidence_kinds": { "const": [] },
              "output_schema": {
                "const": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["result", "reasonCode"],
                  "properties": {
                    "result": { "enum": ["Authenticated", "Unauthenticated", "Indeterminate"] },
                    "reasonCode": { "type": ["string", "null"] }
                  },
                  "allOf": [
                    {
                      "if": { "properties": { "result": { "const": "Indeterminate" } }, "required": ["result"] },
                      "then": { "properties": { "reasonCode": { "type": "string", "minLength": 1 } } },
                      "else": { "properties": { "reasonCode": { "type": "null" } } }
                    }
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "evidence_kinds": {
                "type": "array",
                "minItems": 1,
                "contains": { "const": "structured" }
              }
            }
          }
        }
      ]
    },
    "selfContainedObjectSchema": {
      "allOf": [
        {
          "$ref": "https://json-schema.org/draft/2020-12/schema"
        }
      ],
      "type": "object",
      "description": "生成器逐项真实编译的 draft 2020-12 封闭对象 Schema。生成管线递归拒绝 $ref/$dynamicRef/$id/$anchor/$dynamicAnchor/patternProperties/unevaluatedProperties，要求每层 object 的 additionalProperties=false 且 required 只引用同层 properties 中已声明字段。",
      "required": ["type", "properties", "additionalProperties"],
      "properties": {
        "$schema": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "$ref": false,
        "$dynamicRef": false,
        "$id": false,
        "$anchor": false,
        "$dynamicAnchor": false,
        "patternProperties": false,
        "unevaluatedProperties": false,
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object"
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  }
}

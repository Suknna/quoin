#!/usr/bin/env bash
#ci/record-ui-observation is the frozen catalog entrypoint of the
#ui.manual-observation scenario (VERIFY-OBSERVATION-001/002). The
#deterministic verifier generates the catalog-bound typed observation
#forms, records closed-field typed observations validated against those
#forms and bound to the observer identity and the exact browser artifact
#digest per cell, and evaluates them against the frozen catalog
#expectations. Free-text approvals never replace typed observations.
#
#Environment contract, set by the verification coordinator or workflow:
#QUOIN_VERIFY_PHASE    setup | action | assert
#QUOIN_VERIFY_CELL     catalog cell id; required for assert, and for
#                       action when the recording is cell-scoped
#QUOIN_VERIFY_FACTS    facts json path the assert phase writes
#QUOIN_VERIFY_WORKDIR  per-cell work directory, defaults under the matrix
#QUOIN_OBSERVATION_INVOCATION  invocation id binding the ledger and forms
#QUOIN_OBSERVATION_TAG         release tag recorded on every form
#QUOIN_OBSERVATION_RELEASE_DIGEST  release subject digest on every form
#QUOIN_OBSERVATION_ORIGIN_DIGEST   qualification site public origin digest
#QUOIN_OBSERVATION_SUBJECTS    directory holding per-cell completed
#                              browser-subject json documents
#QUOIN_OBSERVATION_BRANDED     frozen branded-chrome resolution json
#QUOIN_OBSERVATION_ARCHITECTURE restrict form generation to one native
#                              architecture (linux/amd64 or linux/arm64)
#QUOIN_OBSERVATION_SUBMISSION  typed submission json for the action phase
#                              (the observer document; observer identity
#                              is the CI OIDC subject in Release
#                              Qualification)
#QUOIN_OBSERVATION_EXPECTED_OBSERVER  invocation observer identity the
#                              submission must carry (the CI OIDC subject)
#QUOIN_UI_MATRIX_DIR   optional invocation-shared matrix directory for
#                       the ledger and forms
set -euo pipefail
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

phase="${QUOIN_VERIFY_PHASE:-}"
if [ -z "$phase" ]; then
  #The coordinator exports QUOIN_VERIFY_PHASE; a manual invocation may
  #pass it as the classic --phase <name> argument pair instead.
  phase=setup
  for phase_arg in "$@"; do
    case "$phase_arg" in
      setup|action|assert) phase="$phase_arg" ;;
    esac
  done
fi
workdir="${QUOIN_VERIFY_WORKDIR:-${QUOIN_UI_MATRIX_DIR:-$PWD/.observation-work}/phase}"
facts_path="${QUOIN_VERIFY_FACTS:-$workdir/facts.json}"
cell="${QUOIN_VERIFY_CELL:-}"
matrix="${QUOIN_UI_MATRIX_DIR:-$workdir/matrix}"
invocation="${QUOIN_OBSERVATION_INVOCATION:?QUOIN_OBSERVATION_INVOCATION is required}"
catalog_path="docs/specs/quoin-v1/contracts/verification-catalog.yaml"
ledger="$matrix/observation-ledger.json"
forms="$matrix/observation-forms.json"
mkdir -p "$matrix" "$workdir"

harness() { go run ./internal/verification/observation/harness "$@"; }

case "$phase" in
  setup)
    #The wizard document is generated from the catalog so every cell is
    #bound to the invocation, release subject digest and browser
    #artifact digest before any value is recorded; regeneration within
    #the same invocation is idempotent content. A native runner scopes
    #its forms to its own architecture through
    #QUOIN_OBSERVATION_ARCHITECTURE.
    harness form \
      --catalog "$catalog_path" \
      --invocation "$invocation" \
      --tag "${QUOIN_OBSERVATION_TAG:-}" \
      --release-subject-digest "${QUOIN_OBSERVATION_RELEASE_DIGEST:?QUOIN_OBSERVATION_RELEASE_DIGEST is required}" \
      --public-origin-digest "${QUOIN_OBSERVATION_ORIGIN_DIGEST:-}" \
      --subjects "${QUOIN_OBSERVATION_SUBJECTS:?QUOIN_OBSERVATION_SUBJECTS is required}" \
      --branded-resolution "${QUOIN_OBSERVATION_BRANDED:-}" \
      --architecture "${QUOIN_OBSERVATION_ARCHITECTURE:-}" \
      --out "$forms"
    cp "$forms" "$workdir/observation-form.json"
    ;;
  action)
    scope_args=()
    if [ -n "$cell" ]; then
      scope_args=(--cell "$cell")
    fi
    observer_args=()
    if [ -n "${QUOIN_OBSERVATION_EXPECTED_OBSERVER:-}" ]; then
      observer_args=(--expected-observer "$QUOIN_OBSERVATION_EXPECTED_OBSERVER")
    fi
    harness record \
      --catalog "$catalog_path" \
      --invocation "$invocation" \
      --ledger "$ledger" \
      --forms "$forms" \
      --submission "${QUOIN_OBSERVATION_SUBMISSION:?QUOIN_OBSERVATION_SUBMISSION is required}" \
      "${scope_args[@]}" "${observer_args[@]}"
    ;;
  assert)
    harness assert-observation \
      --catalog "$catalog_path" \
      --invocation "$invocation" \
      --ledger "$ledger" \
      --cell "${cell:?QUOIN_VERIFY_CELL is required for the assert phase}" \
      --facts "$facts_path"
    ;;
  *)
    echo "unknown phase $phase, expected setup or action or assert" >&2
    exit 2
    ;;
esac
